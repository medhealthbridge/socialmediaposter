{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?__route=api/:path*"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api?__route=oauth/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "/api?__route=media/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 * * * *"
    }
  ]
}
